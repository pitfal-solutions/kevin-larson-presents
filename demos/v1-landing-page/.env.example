# Admin dashboard (/admin). Required — without it the admin page is locked.
ADMIN_PASSWORD=
# Optional: separate signing secret for the admin session cookie.
# ADMIN_SESSION_SECRET=

# Traffic + lead storage. Leave blank locally to use .data/analytics.json.
# On Vercel, add the Upstash for Redis integration (Storage tab) and these
# are set automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
